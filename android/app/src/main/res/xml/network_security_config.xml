<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV panels are usually plain http on custom ports, chosen by the user. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
